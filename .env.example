# Copy to apps/web/.env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://gxzwdqhdlazandooterd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only - gives full DB access. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend). Sending stays off until EMAIL_SENDING_ENABLED=true and the key is set.
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="Smith Bros Floors <onboarding@resend.dev>"
# Comma-separated staff addresses that get a "new lead" email
ALERT_EMAILS=
# Public base URL of this app (used for links in emails)
APP_URL=http://localhost:3000
# Calendly link shown in the customer's estimate email
CALENDLY_URL=
# Comma-separated website origins allowed to post to /api/intake from a browser
ALLOWED_ORIGINS=

# Marketing campaigns (System 2)
# AI (OpenAI). One key switches on every AI feature: email summaries and reply drafts, the dashboard chat,
# lead email drafts and campaign drafts. Leave empty and the dashboard works without them.
# After setting it, run:  npm --prefix apps/web run ai:check
OPENAI_API_KEY=
# Model for writing and chat. Use any chat model the key can access.
OPENAI_MODEL=gpt-4.1
# Smith Bros mailing address, printed in every marketing email footer (required to send outside demo mode)
COMPANY_ADDRESS=
# Secret used to sign unsubscribe links. Defaults to the service key if unset; set your own in production.
UNSUBSCRIBE_SECRET=

# Email assistant (inbox). n8n sends new mail to /api/inbound/email with this secret in the x-webhook-secret header.
# Use a long random value (at least 16 characters). The endpoint refuses to run without it.
INBOUND_WEBHOOK_SECRET=
# The business inbox's own address. Mail from this address is ignored, so replies never loop.
INBOX_ADDRESS=
# Cheaper, faster model used for summarizing and sorting incoming email
OPENAI_TRIAGE_MODEL=gpt-4.1-mini

# Email assistant: sending approved replies from the owner's Gmail through an n8n workflow.
# Both must be set for sending to work; until then approved replies are kept ready and nothing is sent.
GMAIL_SEND_WEBHOOK_URL=
GMAIL_SEND_SECRET=
# Optional: point AI requests elsewhere (used for testing). Leave empty normally.
OPENAI_BASE_URL=


# Help window (sidebar "Help"). Where the client can reach their support provider. Leave all empty to hide Help.
# SUPPORT_BOOKING_URL must start with https://
SUPPORT_BOOKING_URL=
SUPPORT_EMAIL=
# Shown as a small "Support by ..." line
SUPPORT_NAME=
