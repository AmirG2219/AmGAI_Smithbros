# Copy to apps/web/.env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://gxzwdqhdlazandooterd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only - gives full DB access. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend). Sending stays off until EMAIL_SENDING_ENABLED=true and the key is set.
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="Smith Bros Floors <onboarding@resend.dev>"
# Comma-separated staff addresses that get a "new lead" email
ALERT_EMAILS=
# Public base URL of this app (used for links in emails)
APP_URL=http://localhost:3000
# Calendly link shown in the customer's estimate email
CALENDLY_URL=
# Comma-separated website origins allowed to post to /api/intake from a browser
ALLOWED_ORIGINS=
